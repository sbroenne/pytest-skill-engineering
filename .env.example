# GitHub Copilot SDK Authentication
# pytest-skill-engineering uses the GitHub Copilot SDK for all LLM calls.
# Authenticate via the GitHub CLI (recommended for local dev):
#   gh auth login
#
# Or set GITHUB_TOKEN directly (recommended for CI):
# GITHUB_TOKEN=ghp_xxx

# Optional: Override judge model for llm_assert / llm_score
# (defaults to the model configured via --llm-model in pyproject.toml)
# AITEST_INTEGRATION_JUDGE_MODEL=gpt-5-mini
